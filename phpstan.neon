# PHPStan as glitchr-studio/ci's workflow runs it: level 5 on src/, the bundle installed alone (no application, so
# no App\ class). phpstan-baseline.neon lists the violations there were at 1.0.0; the CI fails on any other. Fix
# one, then drop its entry.
includes:
    - phpstan-baseline.neon
    # The finder language (findByXNull(), sumOfXBy()...) and the entities' __call() accessors, as omnisense/omnibase describes them.
    - vendor/omnisense/omnibase/extension.neon

parameters:
    level: 5
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
